pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

function spawn_bullet()
    -- choose a random side
    local side=flr(rnd(4))

    local x
    local y
    local dx
    local dy

    -- top
    if side==0 then
        x=rnd(128)
        y=-4

        dx=(64-x)/100
        dy=1

    -- right
    elseif side==1 then
        x=132
        y=rnd(128)

        dx=-1
        dy=(64-y)/100

    -- bottom
    elseif side==2 then
        x=rnd(128)
        y=132

        dx=(64-x)/100
        dy=-1

    -- left
    else
        x=-4
        y=rnd(128)

        dx=1
        dy=(64-y)/100
    end

    add(bullets,{
        x=x,
        y=y,
        w=4,
        h=4,
        dx=dx,
        dy=dy
    })
end

function bullet_collision_check(b)
    local hit = b.x + b.w > player.x and b.x < player.x + player.w and b.y + b.h > player.y and b.y < player.y + player.h
    return hit -- right and left edges of bullet, then top and bottom edges of bullet
end

function update_bullets()
    for b in all(bullets) do

        if not b.stopped then
            -- move horizontally
            b.x+=b.dx

            -- move vertically
            b.y+=b.dy

            -- apply gravity
            b.dy+=gravity*gravity_dir
        end

        -- remove bullets outside the screen
        if b.x < -8 or b.x > 136 or
           b.y < -8 or b.y > 136 then

            del(bullets,b)
        -- detect if this bullet hit crush
        elseif death_timer == 0 and bullet_collision_check(b) then
            b.stopped=true
            death_timer = 30
            hit_flash_timer = 30
            sfx(61)
        end

    end
end


function draw_bullets()
    for b in all(bullets) do
        circfill(b.x,b.y,2,8)
    end
end

has_started = false

function _init()
    dead = false
    death_timer = 0
    hit_flash_timer = 0
    score = 0

    if has_started == false then
        is_playing = false
    else
        is_playing = true
    end
    
    -- gravity
    gravity=0.15
    gravity_dir=1

    -- bullet logic
    bullets={}
    shoot_timer=0
    spawn_rate=10
    speed_up_game=0

	--crush setup
	player={
		x = 60,
		y = 60,
        w = 8,
        h = 8,
		sprite=1
	}

    -- map scrolling
    scroll_position_x=0

	animation_timer=0
end

function _update()

    -- game not over
    if is_playing then
        has_started = 1
        score+=1

        -- map scrolling
        scroll_position_x = scroll_position_x + 1
        scroll_position_x = scroll_position_x % 256 -- 32 map tiles = 256 pixels

        -- up arrow: gravity goes upward
        if btnp(2) then
            gravity_dir=-1
        end

        -- down arrow: gravity goes downward
        if btnp(3) then
            gravity_dir=1
        end


        -- walking animation
        animation_timer+=1

        if animation_timer>=6 then
            animation_timer=0

            player.sprite+=1

            if player.sprite>3 then
                player.sprite=1
            end
        end	

        -- constantly spawn bullets
        speed_up_game+=1
        shoot_timer+=1

        if speed_up_game>=900 then -- every 30s
            speed_up_game=0
            if spawn_rate>1 then
                spawn_rate-=1
            end
        end

        if shoot_timer>=spawn_rate then -- spawns them faster (according to above func)
            shoot_timer=0
            spawn_bullet()
        end
        
        if hit_flash_timer > 0 then
            hit_flash_timer-=1
        end

        if death_timer > 0 then
            death_timer-=1
            if death_timer == 0 then
                dead=true
            end
        end

        update_bullets()

        if dead == true then
            is_playing=false
        end
    ----------------------------
    -- game over
    elseif is_playing == false and dead == true then
        if btnp(4) then
            has_started=true
            _init()
        elseif btnp(5) then
            has_started=false
            _init()
        end

    -- title screen
    else
        if btnp(4) then
            is_playing = true
            music(0)
        end
    end
end

function _draw()
    cls(1) -- clear the screen
    if is_playing then

        palt(0, false) -- black is not transparent
        -- map
        map(0,0,-scroll_position_x,0,32,16)
        map(0,0,-scroll_position_x+256,0,32,16)

        palt() -- make black transparent again
        -- player
        local player_draw_x=player.x
        local player_draw_y=player.y
        if hit_flash_timer > 0 then
            pal(1,8)
            pal(4,8)
            pal(13,8)
            pal(15,8)
            player_draw_x+=flr(rnd(3))-1
            player_draw_y+=flr(rnd(3))-1
        end
        spr(player.sprite,player_draw_x,player_draw_y)
        pal()

        -- bullets
        draw_bullets()

        -- gravity indicator
        if gravity_dir==1 then
            print("gravity: down",2,2,7)
        else
            print("gravity: up",2,2,7)
        end

        print("score: " .. score)

    elseif is_playing == false and dead == true then
        cls(0)
        print("game over. your score was " .. score .. "\npress z to try again,\npress x to quit",2,63,8)

    -- title screen
    else
        cls(0)
        print("\^w\^tDODGE-ITY",2,20,8)
        print("you just realized.. you control \ngravity. you must defend your \ncrush from dodgeballs\n\nuse the up and down controls\nto control gravity's direction\npress z to play",2,43,7)


    end
end



