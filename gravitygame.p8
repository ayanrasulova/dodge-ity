pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
#include bullets.lua

has_started = false

function _init()
    dead = false
    death_timer = 0
    score = 0

    if has_started == false then
        is_playing = false
    else
        is_playing = true
    end
    
    -- gravity
    gravity=0.15
    gravity_dir=1

    -- bullet logic
    bullets={}
    shoot_timer=0
    spawn_rate=10
    speed_up_game=0

	--crush setup
	player={
		x = 60,
		y = 60,
        w = 8,
        h = 8,
		sprite=1
	}

    -- map scrolling
    scroll_position_x=0

	animation_timer=0
end

function _update()

    -- game not over
    if is_playing then
        has_started = 1
        score+=1

        -- map scrolling
        scroll_position_x = scroll_position_x + 1
        scroll_position_x = scroll_position_x % 256 -- once the position is at the end, reset

        -- up arrow: gravity goes upward
        if btnp(2) then
            gravity_dir=-1
        end

        -- down arrow: gravity goes downward
        if btnp(3) then
            gravity_dir=1
        end


        -- walking animation
        animation_timer+=1

        if animation_timer>=6 then
            animation_timer=0

            player.sprite+=1

            if player.sprite>3 then
                player.sprite=1
            end
        end	

        -- constantly spawn bullets
        speed_up_game+=1
        shoot_timer+=1

        if speed_up_game>=900 then -- every 30s
            speed_up_game=0
            if spawn_rate>1 then
                spawn_rate-=1
            end
        end

        if shoot_timer>=spawn_rate then -- spawns them faster (according to above func)
            shoot_timer=0
            spawn_bullet()
        end
        
        if death_timer > 0 then
            death_timer-=1
            if death_timer == 0 then
                dead=true
            end
        else
            update_bullets()
        end

        if dead == true then
            is_playing=false
        end
    ----------------------------
    -- game over
    elseif is_playing == false and dead == true then
        if btnp(4) then
            has_started=true
            _init()
        elseif btnp(5) then
            has_started=false
            _init()
        end

    -- title screen
    else
        if btnp(4) then
            is_playing = true
        end
    end
end

function _draw()
    cls(1) -- clear the screen
    if is_playing then

        -- map
        map(0,0,-scroll_position_x,0,64,16)
        map(0,0,-scroll_position_x+128,0,64,16)

        -- player
        spr(player.sprite,player.x,player.y)

        -- bullets
        draw_bullets()

        -- gravity indicator
        if gravity_dir==1 then
            print("gravity: down",2,2,7)
        else
            print("gravity: up",2,2,7)
        end

        print("score: " .. score)

    elseif is_playing == false and dead == true then
        print("game over. your score was " .. score .. "\npress z to try again\npress x to quit",2,63,7)

    -- title screen
    else
        print("press z to play",63,63,7)


    end
end



